# ==============================================================================
# LangGraph Agent 环境变量配置示例
# 复制为 .env 或直接在项目根目录下配置 .env 即可生效
# ==============================================================================

# 主大模型配置（兼容 OpenAI 规范：DeepSeek / OpenAI / Qwen / Moonshot / Ollama）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# 可选：用于 FactChecker 独立异构交叉核验模型（如 deepseek-reasoner 或 qwen-max）
# 若留空，自动使用 MODEL_NAME
REASONING_MODEL_NAME=

# 预算与三维熔断阀门
BUDGET_MAX_TOKENS_PER_TASK=60000
BUDGET_MAX_STEPS_PER_TASK=15
BUDGET_MAX_SECONDS_PER_TASK=120

# 生产审批模式：interactive (控制台人工确认) / auto_approve (CI测试自动放行)
APPROVAL_MODE=auto_approve
