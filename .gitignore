# ==============================================================================
# multi-agent-practice .gitignore
# ==============================================================================

# Python Bytecode & Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.pyenv/
.venv/
env/
venv/
ENV/

# Environment Variables & Private Secrets
.env
.env.local
.env.*.local
!.env.example
!**/.env.example

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
.project
.pydevproject
.settings/

# OS Specific
.DS_Store
Thumbs.db
Desktop.ini

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Runtime Logs, Checkpoints & Caches
*.log
checkpoints/
.cache/
.codegraph
*.tmp
*.sqlite
*.db

# Temporary scratch & improvements
IMPROVEMENTS.md
