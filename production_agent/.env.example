# OpenAI API 兼容格式配置（支持 OpenAI, DeepSeek, Qwen, Moonshot, 本地 Ollama 等）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# 可选：用于第 7 篇“异构模型交叉校验”的第二模型（如 deepseek-reasoner 或 qwen-max）
# 若不填写，默认使用 MODEL_NAME
REASONING_MODEL_NAME=

# 预算与熔断默认阈值
BUDGET_MAX_TOKENS_PER_TASK=60000
BUDGET_MAX_STEPS_PER_TASK=15
BUDGET_MAX_SECONDS_PER_TASK=120

# 生产审批模式：interactive (控制台人工确认) / auto_approve (CI测试自动通过)
APPROVAL_MODE=auto_approve
