# ==============================================================================
# Production Agent 环境变量配置示例
# 复制为 .env 或直接在项目根目录下配置 .env 即可生效
# ==============================================================================

# 主大模型配置（兼容 OpenAI 规范：DeepSeek / OpenAI / Qwen / Moonshot / Ollama）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# 常见国内与本地模型接入示例：
# [DeepSeek]
# OPENAI_API_KEY=sk-your-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-chat
#
# [Qwen 通义千问]
# OPENAI_API_KEY=sk-your-qwen-key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus
#
# [本地 Ollama]
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=qwen2.5:7b

# 可选：用于第 007 篇 FactChecker 独立异构交叉核验模型（如 deepseek-reasoner 或 qwen-max）
# 若留空，自动使用 MODEL_NAME
REASONING_MODEL_NAME=

# 运行预算与三维熔断阀门（第 008 篇 Token/步数/挂钟时延防雪崩机制）
BUDGET_MAX_TOKENS_PER_TASK=60000
BUDGET_MAX_STEPS_PER_TASK=15
BUDGET_MAX_SECONDS_PER_TASK=120

# 生产安全闸门与审批模式（第 010 篇 Two-Man Rule 双人签字机制）
# auto_approve: CI/自动回归测试模式，自动放行
# interactive:  生产交互模式，控制台人工确认 (y/n)
APPROVAL_MODE=auto_approve
