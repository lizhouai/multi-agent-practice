# ==============================================================================
# multi-agent-practice 环境变量配置示例
# 复制本文件为 .env 并在需要时填入相应 API Key：
#   cp .env.example .env
#
# 说明：
# 本项目原生支持“零配置离线 Mock 模式”。未配置 API KEY 时，全链路会自动采用
# 内置的高仿真 Mock 数据秒级跑通，无需任何付费即可完整体验三轨架构与评测体系。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 主大模型配置（兼容 OpenAI 规范：DeepSeek / OpenAI / Qwen / Moonshot / Ollama）
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# 常见国内与本地模型接入示例：
# [DeepSeek]
# OPENAI_API_KEY=sk-your-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-chat
#
# [Qwen 通义千问]
# OPENAI_API_KEY=sk-your-qwen-key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus
#
# [本地 Ollama]
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=qwen2.5:7b

# ------------------------------------------------------------------------------
# 2. 异构核验大模型配置（用于第 007 篇 FactChecker 独立异构交叉核验）
# ------------------------------------------------------------------------------
# 若为空，则自动回退复用主模型 MODEL_NAME；
# 若填写（如 deepseek-reasoner 或 qwen-max），核验节点将独立调用不同厂商/参数规模的模型进行辩论与纠错。
REASONING_MODEL_NAME=

# ------------------------------------------------------------------------------
# 3. 运行预算与三维熔断阀门（第 008 篇 Token/步数/挂钟时延防雪崩机制）
# ------------------------------------------------------------------------------
BUDGET_MAX_TOKENS_PER_TASK=60000
BUDGET_MAX_STEPS_PER_TASK=15
BUDGET_MAX_SECONDS_PER_TASK=120

# ------------------------------------------------------------------------------
# 4. 生产安全闸门与审批模式（第 010 篇 Two-Man Rule 双人签字机制）
# ------------------------------------------------------------------------------
# auto_approve: CI/自动回归测试模式，遇到 L2 不可逆高危动作时自动放行
# interactive:  生产人机交互模式，在控制台弹出拦截警告并等待人工确认输入 (y/n)
APPROVAL_MODE=auto_approve

# ------------------------------------------------------------------------------
# 5. 检索源配置（可选）
# ------------------------------------------------------------------------------
# SEARCH_PROVIDER=mock (默认离线模式)
# 若接入真实联网搜索（可选）：
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=tvly-your-api-key
